{
  "name": "blog-codespaces",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "runArgs": [
    "--shm-size=1gb"
  ],
  "mounts": [
    "source=blog-dc-claude,target=/home/vscode/.claude,type=volume",
    "source=blog-dc-gemini,target=/home/vscode/.gemini,type=volume",
    "source=blog-dc-cache,target=/home/vscode/.cache,type=volume"
  ],
  "forwardPorts": [1313, 1314, 2222],
  "containerEnv": {
    "CHROME": "/usr/local/bin/chromium-headless",
    "UV_LINK_MODE": "copy",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "NPM_CONFIG_CACHE": "/home/vscode/.cache/npm",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
